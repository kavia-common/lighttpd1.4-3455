{"is_source_file": true, "format": "C", "description": "This file implements the 'mod_nss' module for lighttpd, providing support for NSS (Network Security Services) including SSL/TLS setup, certificate loading, SNI handling, ALPN negotiation, OCSP stapling, and configuration parsing. It contains functions for initializing NSS, loading certificates and keys, configuring SSL parameters, and managing per-connection SSL contexts.", "external_files": ["first.h", "<sys/types.h>", "<sys/stat.h>", "<errno.h>", "<fcntl.h>", "<stdarg.h>", "<stdlib.h>", "<stdio.h>", "<string.h>", "<nspr4/nspr.h>", "<nspr4/private/pprio.h>", "<nss3/nss.h>", "<nss3/nssb64.h>", "<nss3/keyhi.h>", "<nss3/pk11pub.h>", "<nss3/secder.h>", "<nss3/secerr.h>", "<nss3/ssl.h>", "<nss3/sslproto.h>", "base.h", "ck.h", "fdevent.h", "http_header.h", "http_kv.h", "log.h", "plugin.h"], "external_methods": ["NSS_IsInitialized", "NSS_NoDB_Init", "NSS_Shutdown", "NSS_SetDomesticPolicy", "NSSBase64_DecodeBuffer", "CERT_GetCertTimes", "CERT_DestroyCertificate", "CERT_DestroyCertificateList", "CERT_NewTempCertificate", "CERT_AddCertToListTail", "CERT_CertChainFromCert", "CERT_CacheCRL", "CERT_UncacheCRL", "CERT_DestroyCertificateList", "CERT_ImportCAChainTrusted", "CERT_CacheCRL", "CERT_SetError", "PR_ImportTCPSocket", "PR_CreateSocketPollFd", "PR_Close", "PR_SetSocketOption", "SSL_ImportFD", "SSL_ConfigServerCert", "SSL_OptionSetDefault", "SSL_VersionRangeSet", "SSL_OptionSet", "SSL_AuthCertificate", "SSL_GetChannelInfo", "SSL_OptionSet", "SSL_OptionSet", "SSL_GeChannelInfo", "SSL_SetTrustAnchors", "SSL_RequestCert", "SSL_OptionSet", "SSL_OptionSet", "SSL_OptionSet", "SSL_OptionSet", "SSL_OptionSet", "SSL_OptionSet", "SSL_OptionSet", "SSL_OptionSet"], "published": ["mod_nss_init", "mod_nss_free"], "classes": [{"name": "mod_nss_kp", "description": "Structure representing NSS key pair and certificate chain information, including private keys, SSL credential extensions, OCSP responses, and reference counting."}, {"name