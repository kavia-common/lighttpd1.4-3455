{"is_source_file": true, "format": "C", "description": "This file implements a plugin module for the lighttpd web server, providing MaxMind GeoIP2 database lookup support. It includes plugin initialization, configuration, database access, and request handling functions, leveraging the MaxMind DB C library to set environment variables with geolocation data.", "external_files": ["first.h", "sys-socket.h", "base.h", "buffer.h", "http_header.h", "log.h", "sock_addr.h", "plugin.h", "<maxminddb.h>"], "external_methods": ["MMDB_open", "MMDB_close", "MMDB_lookup_sockaddr", "MMDB_aget_value", "MMDB_strerror"], "published": ["mod_maxminddb_plugin_init"], "classes": [], "methods": [{"name": "int mod_maxminddb_plugin_init(plugin * p)", "description": "Initializes the maxminddb plugin by setting up the plugin's function pointers and basic metadata.", "scope": "", "scopeKind": ""}, {"name": "mod_maxminddb_init", "description": "Allocates and initializes memory for the plugin data structure."}, {"name": "mod_maxminddb_free", "description": "Cleans up and frees resources associated with the plugin, including closing the MaxMind database handle and freeing environment arrays."}, {"name": "MMDB_s * mod_maxminddb_open_db(server * srv,const buffer * db_name)", "description": "Opens a MaxMind GeoIP2 database file, verifying its filename ends with '.mmdb', and returns a pointer to the database handle.", "scope": "", "scopeKind": ""}, {"name": "plugin_config_env * mod_maxminddb_prep_cenv(server * srv,const array * const env)", "description": "Prepares the environment key-value list for querying MaxMind database, parsing the configuration array into a structured format.", "scope": "", "scopeKind": ""}, {"name": "void mod_maxminddb_merge_config_cpv(plugin_config * const pconf,const config_plugin_value_t * const cpv)", "description": "Merges configuration values specific to the plugin, such as database path and environment settings.", "scope": "", "scopeKind": ""}, {"name": "void mod_maxmind