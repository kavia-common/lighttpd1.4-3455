{"is_source_file": true, "format": "C", "description": "This file implements the 'mod_extforward' module for the lighttpd web server, handling trusted proxy configurations, parsing proxy headers like the Forwarded header, and support for HAProxy protocol v1/v2. It manages the trust relationship for proxies, restores client IP addresses, and processes headers related to proxy forwarding, including support for chained proxies and extended protocol details.", "external_files": ["first.h", "base.h", "log.h", "buffer.h", "http_header.h", "http_status.h", "request.h", "sock_addr.h", "plugin.h", "sys-socket.h"], "external_methods": ["buffer_eq_icase_slen", "array_get_element_klen", "http_header_hkey_get", "http_header_request_get", "http_header_env_set", "array_insert_value", "array_set_key_value", "array_free", "array_free_data", "config_check_cond", "sock_addr_from_str_numeric", "sock_addr_inet_pton", "sock_addr_assign", "sock_addr_inet_ntop_copy_buffer", "buffer_is_blank", "buffer_eq_icase_ssn", "buffer_eq_icase_ss", "light_isxdigit", "light_isdigit", "light_btst", "log_error", "log_perror", "config_parse_int", "config_plugin_values_init", "config_cond_cache_reset_item", "request_st", "connection", "chunkqueue", "buffer", "lighttpd_version_id"], "published": ["mod_extforward_plugin_init"], "classes": [{"name": "proxy_forwarded_t", "description": "Enumeration of flags representing different proxy forwarding options (for, proto, host, by, remote_user)."}, {"name": "sock_addr_mask", "description": "Structure combining a socket address with a mask length for CIDR notation."}, {"name": "forwarder_cfg", "description": "Configuration structure for trusted proxy forwarders, including address list, trust level, and CIDR masks."}, {"name": "plugin_config", "description": "Per-instance configuration for the mod_extforward plugin, including trust settings, headers, options, and flags."}, {"name": "plugin_data", "description": "Main plugin data structure, containing defaults, headers, and token array for request processing."}, {"name": "handler_rctx", "description": "Request context for handling remote IP address restoration, storing a sock_addr and buffer."}, {"name": "handler_ctx", "description": "Connection context for mod_extforward, tracking trust status and environment headers, as well as SSL verification state."}, {"name": "hap_PROXY_hdr", "description": "Union type representing different versions of HAProxy proxy protocol headers (v1 and v2)."}, {"name": "pp2_tlv", "description": "TLV (Type-Length-Value) structure used in HAProxy protocol v2 extensions."}, {"name": "pp2_tlv_ssl", "description": "Specific TLV structure for SSL information in HAProxy protocol v2."}], "methods": [{"name": "__attribute_malloc__ __attribute_returns_nonnull__ handler_rctx * handler_rctx_init(void)", "description": "Allocates and initializes a new request context for remote IP restoration.", "scope": "", "scopeKind": ""}, {"name": "void handler_rctx_free(handler_rctx * rctx)", "description": "Frees the request context used for restoring remote IP addresses.", "scope": "", "scopeKind": ""}, {"name": "__attribute_malloc__ __attribute_returns_nonnull__ handler_ctx * handler_ctx_init(void)", "description": "Allocates and initializes a new connection context for mod_extforward.", "scope": "", "scopeKind": ""}, {"name": "void handler_ctx_free(handler_ctx * hctx)", "description": "Frees the connection context.", "scope": "", "scopeKind": ""}, {"name": "mod_extforward_plugin_data", "description": "Global pointer to the plugin data instance; used for managing module state."}, {"name": "mod_extforward_init", "description": "Initializes plugin data structure for mod_extforward."}, {"name": "mod_extforward_free", "description": "Frees allocated resources for the plugin, including headers and dynamic config data."}, {"name": "mod_extforward_merge_config_cpv", "description": "Merges individual configuration plugin values into the plugin's runtime configuration."}, {"name":